# Normalize source and documentation.
* text=auto
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf

# Keep binary assets untouched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.otf binary
*.ttf binary
*.mov binary
*.mp4 binary
*.svg text eol=lf
